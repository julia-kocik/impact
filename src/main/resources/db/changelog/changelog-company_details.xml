<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="company_details-1" author="jkocik">
        <createTable tableName="company_details">
            <column name="id" type="uuid">
                <constraints nullable="false" primaryKeyName="pk_company_details_id" primaryKey="true"/>
            </column>
            <column name="name" type="varchar"/>
            <column name="industry" type="varchar"/>
            <column name="size" type="int"/>
            <column name="logo" type="varchar"/>
            <column name="description" type="varchar"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
